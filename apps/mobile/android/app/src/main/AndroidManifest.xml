<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- kr.readme.app://i/<토큰> 같은 앱 주소 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kr.readme.app" />
            </intent-filter>

            <!-- 앱 링크: 운영 도메인의 /r/*(물어보기)와 /s/*(링크로 받은 기록)를 앱으로 연다. 도메인은 res/values/strings.xml 의 app_link_host,
                 서버의 /.well-known/assetlinks.json 에 서명 지문이 있어야 검증된다(README "앱 링크") -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/app_link_host" android:pathPrefix="/r/" />
                <data android:scheme="https" android:host="@string/app_link_host" android:pathPrefix="/s/" />
            </intent-filter>

            <!-- 다른 앱(삼성 노트·Google Keep 등)의 공유 메뉴에서 "기억해유"로 보낸 글을 메모 쓰는 화면으로 받는다(ShareInboxPlugin) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 서버 푸시(FCM) 알림 모양: 작은 흰 아이콘 + 망고색 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 말로 적기: 기기 음성 인식(@capacitor-community/speech-recognition) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 메모 쓰기 화면 '메모 앱에서': 깔린 메모 앱을 보고 연다(ShareInboxPlugin.NOTES_APPS와 같게). 안드로이드 11부터는 여기 적은 앱만 보인다 -->
        <package android:name="com.samsung.android.app.notes" />
        <package android:name="com.google.android.keep" />
        <package android:name="com.nhn.android.navermemo" />
        <package android:name="com.socialnmobile.dictapp.notepad.color.note" />
        <package android:name="com.microsoft.office.onenote" />
        <package android:name="com.evernote" />
    </queries>
</manifest>
